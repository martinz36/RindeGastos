generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
}

enum ExpenseType {
  CAJA_CHICA
  MOVILIDAD
}

enum ExpenseStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  rol       Role     @default(WORKER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pettyCash PettyCash?
  expenses  Expense[]

  @@map("users")
}

model PettyCash {
  id           String             @id @default(cuid())
  user_id      String             @unique
  saldo_actual Decimal            @default(0.00) @db.Decimal(12, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deposits     PettyCashDeposit[]

  @@map("petty_cash")
}

model PettyCashDeposit {
  id            String    @id @default(cuid())
  petty_cash_id String
  monto         Decimal   @db.Decimal(12, 2)
  descripcion   String
  fecha         DateTime  @default(now())

  pettyCash     PettyCash @relation(fields: [petty_cash_id], references: [id], onDelete: Cascade)

  @@map("petty_cash_deposits")
}

model Expense {
  id                String        @id @default(cuid())
  user_id           String
  monto             Decimal       @db.Decimal(12, 2)
  tipo              ExpenseType
  estado            ExpenseStatus @default(PENDIENTE)
  concepto          String
  receipt_url       String?
  fecha             DateTime      @default(now())
  
  // Detalle exclusivo para Movilidad (según normativa SUNAT / control interno)
  origen            String?
  destino           String?
  motivo            String?
  
  // Metadatos de comprobante
  comprobanteTipo   String?       // BOLETA, FACTURA, TICKET, DECLARACION_JURADA
  comprobanteNumero String?
  
  // Liquidación y desembolso
  pagado            Boolean       @default(false)
  fechaPago         DateTime?
  motivoRechazo     String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("expenses")
}

